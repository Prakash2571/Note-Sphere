# Auth.js — keep AUTH_SECRET stable across deployments.
AUTH_SECRET=your-stable-random-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# MongoDB
MONGODB_URI=mongodb://localhost:27017/note-sphere

# Cloudflare R2 — server-side only; never use NEXT_PUBLIC_ for credentials.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_NOTES_BUCKET=note-sphere-private-notes
R2_AVATARS_BUCKET=note-sphere-public-avatars
R2_AVATARS_PUBLIC_URL=https://avatars.example.com

# AI summaries
GEMINI_API_KEY=your-gemini-api-key
