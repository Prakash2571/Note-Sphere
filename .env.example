# ─────────────────────────────────────────────────────────────────────────────
# Note-Sphere environment variables
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth.js (next-auth v5) ───────────────────────────────────────────────────
# REQUIRED. Stable secret used to sign/encrypt JWTs. This MUST be set to the
# SAME stable value in every environment (dev, preview, production). If it is
# unset or changes between deploys/cold starts, existing sessions are
# invalidated early and users get logged out before the 2-day window.
# Generate one with: `openssl rand -base64 32`
AUTH_SECRET=your-stable-random-secret

# Base URL of the app, used when building share links (e.g. https://your-app.com).
AUTH_URL=http://localhost:3000

# Google OAuth credentials (read automatically by Auth.js v5).
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string used by lib/mongodb.ts (connectDB).
MONGODB_URI=mongodb://localhost:27017/note-sphere

# ── AWS S3 (PDF storage) ─────────────────────────────────────────────────────
# Used by lib/s3.ts for uploads, deletes, and pre-signed viewing URLs.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# ── Google Gemini (AI summarize) ─────────────────────────────────────────────
# Used by lib/gemini.ts to generate note summaries.
GEMINI_API_KEY=your-gemini-api-key
